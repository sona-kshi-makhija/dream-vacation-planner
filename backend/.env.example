# Copy this file to .env and fill in your real values.
# Never commit the real .env file to Git.

# Server
PORT=5000
NODE_ENV=production

# Amazon RDS MySQL connection details
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-strong-password
DB_NAME=dream_vacation_planner

# Allowed frontend origin (used for CORS). In production this is usually
# your domain, e.g. https://www.yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Authentication
# JWT_SECRET should be a long, random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse this example value in a real deployment.
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
